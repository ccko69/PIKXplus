<selector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- pressed state with red stroke -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <size
                android:height="20dp"
                android:width="6dp"/>
            <solid android:color="@color/white"/>
            <stroke
                android:width="2dp"
                android:color="@color/clr_PrimDark"/>
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp"/>
        </shape>
    </item>
    <!-- default state -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:height="20dp"
                android:width="6dp"/>
            <solid android:color="@color/white"/>
            <stroke
                android:width="1dp"
                android:color="@color/gry_dark"/>
        </shape>
    </item>
</selector>
