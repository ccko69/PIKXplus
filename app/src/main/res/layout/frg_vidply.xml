<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false">
    <!-- Media3 PlayerView (replaces ExoPlayer StyledPlayerView) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPly"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@color/black"
        android:fitsSystemWindows="false"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:resize_mode="fit"/>
    <!-- Custom Video Controls Overlay (VidCtrl) -->
    <com.ccko.pikxplus.viewers.vid.VidCtrl
        android:id="@+id/vidCtrlRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"/>
</FrameLayout>