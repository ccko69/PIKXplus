<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_height="match_parent"
android:layout_width="match_parent"
android:background="@color/black"
android:clipChildren="false"
android:fitsSystemWindows="false"
android:clipToPadding="false"
android:id="@+id/imgVRoot">
    <androidx.viewpager2.widget.ViewPager2
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:clickable="false"
    android:longClickable="true"
    android:id="@+id/vP2" />
    <View
    android:layout_height="match_parent"
    android:layout_width="30dp"
    android:layout_marginBottom="100dp"
    android:layout_marginEnd="4dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:backgroundTint="#00000000"
    android:layout_marginTop="80dp"
    android:id="@+id/hotspotR"
    android:layout_gravity="end" />
    <View
    android:layout_height="match_parent"
    android:layout_width="30dp"
    android:layout_marginBottom="100dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:backgroundTint="#00000000"
    android:layout_marginTop="80dp"
    android:layout_marginStart="4dp"
    android:id="@+id/hotspotL"
    android:layout_gravity="start" />
    <include
    layout="@layout/float_img_fab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToOutline="false"
    android:clipToPadding="false"
    android:id="@+id/fabContainer"
    android:layout_gravity="end|bottom" />
    <LinearLayout
    android:layout_height="80dp"
    android:layout_width="match_parent"
    android:background="@drawable/gradient_top2bottom_fade"
    android:orientation="horizontal"
    android:fitsSystemWindows="false"
    android:id="@+id/topBar"
    android:layout_gravity="top"
    android:paddingTop="10dp">
        <ImageButton
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="left"
        android:clickable="true"
        android:padding="4dp"
        android:tint="#FFFFFF"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        android:focusable="auto"
        android:id="@+id/backBtn" />
        <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="wrap_content"
        android:gravity="left"
        android:padding="2dp"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_gravity="center_vertical">
            <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:gravity="bottom"
            android:padding="2dp"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_marginTop="14dp"
            android:id="@+id/imgIndex"
            android:text="1 / 10"
            android:textStyle="bold" />
            <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:gravity="bottom"
            android:ellipsize="middle"
            android:padding="2dp"
            android:textSize="14sp"
            android:textColor="@color/gry_light"
            android:maxLines="1"
            android:id="@+id/imgName"
            android:text="Image Name"
            android:textStyle="bold" />
        </LinearLayout>
        <View
        android:layout_height="match_parent"
        android:layout_width="4dp"
        android:layout_weight="0" />
        <ImageButton
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:visibility="gone"
        android:src="@drawable/ic_play_circle"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="right"
        android:clickable="true"
        android:padding="4dp"
        android:tint="#FFFFFF"
        android:layout_marginTop="10dp"
        android:focusable="auto"
        android:id="@+id/vidPlayBtn" />
        <ImageButton
        android:layout_height="48dp"
        android:layout_width="48dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="right"
        android:clickable="true"
        android:padding="4dp"
        android:tint="#FFFFFF"
        android:layout_marginTop="10dp"
        android:focusable="auto"
        android:id="@+id/moreBtn" />
    </LinearLayout>
    <LinearLayout
    android:layout_height="80dp"
    android:layout_width="match_parent"
    android:background="@drawable/gradient_bottom2top_fade"
    android:gravity="center"
    android:paddingVertical="8dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:id="@+id/botBar"
    android:layout_gravity="bottom">
        <androidx.recyclerview.widget.RecyclerView
        android:layout_height="60dp"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:id="@+id/stripRecycler"
        android:overScrollMode="never" />
    </LinearLayout>
</FrameLayout>