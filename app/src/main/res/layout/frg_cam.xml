<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#CC161616"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:id="@+id/CamRoot">
    <TextView
        android:layout_height="80dp"
        android:layout_width="match_parent"
        android:background="@drawable/gradient_top2bottom_fade"
        android:padding="16dp"
        android:textSize="20sp"
        android:fitsSystemWindows="false"
        android:textColor="#FFFFFF"
        style="@style/DrkShdwR3x1y1"
        android:layout_gravity="top|start"
        android:id="@+id/StorageTitle"
        android:text="Storage"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_weight="1"
        android:layout_gravity="center">
        <!-- temporarily buttons for testing. -->
        <com.google.android.material.button.MaterialButton
            android:layout_height="90dp"
            android:layout_width="90dp"
            app:backgroundTint="#FFFFFF"
            android:layout_margin="8dp"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btnL"
            android:foreground="@drawable/gradient_top2bottom_fade"
            android:layout_gravity="center_vertical|start" />
        <com.google.android.material.button.MaterialButton
            android:layout_height="90dp"
            android:layout_width="90dp"
            app:backgroundTint="#000000"
            android:layout_margin="8dp"
            app:cornerRadius="8dp"
            android:id="@+id/btnM"
            android:foreground="@drawable/glassy_edges"
            android:layout_gravity="center_vertical" />
        <com.google.android.material.button.MaterialButton
            android:layout_height="90dp"
            android:layout_width="90dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#600020"
            android:layout_margin="8dp"
            app:cornerRadius="8dp"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:id="@+id/btnR"
            android:foreground="@drawable/gradient_bottom2top_fade"
            android:layout_gravity="center_vertical|end" />
    </LinearLayout>
    <!-- this is a temporary text view; it's supposed to work as internal Log.
    TODO: wire the `textLog` so it can be called from any activity/fragment. -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_height="300dp"
        android:layout_width="match_parent"
        android:background="#BBBBBB"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_gravity="bottom"
        android:id="@+id/textLog" />
</LinearLayout>
